ges/logo-preto-meta.png\" />\n\n    \n    <link id=\"com.ibm.lotus.NavStateUrl\" rel=\"alternate\" href=\"/sp/!ut/p/z1/04_Sj9CPykssy0xPLMnMz0vMAfIjo8ziDSzMTIyM3Q2MA4KDnA3MfA0tnX0t3Yw9nY31wyEKcABHA_0oovTjVhCF3_hw_ShCSgpyQyMM0hUVAcr914U!/dz/d5/L2dJQSEvUUt3QS80TmxFL1o2XzA4NjQyM0cwM1BTUkMwNk0xOUNNOUYzSUMz/\">\n\n    \n    <link href=\"/statics/periodo-eleitoral/favicon2.ico\" rel=\"shortcut icon\" type=\"image/x-icon\">\n\n    <!-- Bootstrap core CSS -->\n    <link href=\"/statics/css/bootstrap.min.css\" rel=\"stylesheet\">\n\n    <!-- Custom styles for this template -->\n    <link href=\"/statics/css/custom.min.css\" rel=\"stylesheet\">\n\n    <!-- Fonts -->\n    <link href=\"/statics/src/core.min.css\" rel=\"stylesheet\">\n    <link href=\"/statics/fontawesome-6.4.2/css/all.min.css\" rel=\"stylesheet\">    \n    <link href=\"/statics/rawline/css/rawline.min.css\" rel=\"stylesheet\">\n      \n    <!-- JQuery -->\n    <script src=\"/statics/js/jquery-3.3.1.min.js\"></script>\n    <script src=\"/statics/js/jquery-migrate-3.4.1.min.js\"></script>  \n\n    <!-- Acessibilidade -->\n    <link href=\"/statics/css/acessibilidade.css\" rel=\"stylesheet\" type=\"text/css\">\n\n    <!-- Plugin JQuery-->\n    <link href=\"/statics/select2/select2.min.css\" rel=\"stylesheet\" type=\"text/css\">\n    <link href=\"/statics/slick/slick/slick.css\" rel=\"stylesheet\" type=\"text/css\">\n    <link href=\"/statics/slick/slick/slick-theme.css\" rel=\"stylesheet\" type=\"text/css\">\n\n    <!-- Bootstrap -->\n    <script src=\"/statics/js/bootstrap.bundle.min.js\"></script>\n\n    <!-- Select2 -->\n    <script src=\"/statics/select2/select2.min.js\"></script>\n\n    <!-- Slick -->\n    <script src=\"/statics/slick/slick/slick.min.js\"></script>\n\n    <!-- Componentes -->\n    <script src=\"/statics/js/custom.js\"></script>\n    <script src=\"/statics/js/agenda.js\"></script>  \n\n    <!-- V1.2-->\n    <script>\n      $( document ).ready(function() {\n        $(\"head\").append(document.getElementById('analytics'));\n      });\n    </script>\n    \n    <style>\n      .tooltipContextMenu,\n      .wpToolbarLogo .wpLogoTooltip {\n        display: none;\n      }\n\n      .wpthemeControlBody, .wpthemeOverflowAuto, .wpthemeClear {\n        overflow:hidden;\n      }\n      \n      .wpthemeInner, .wpthemeSecondaryNav {\n          margin: 0 auto;\n        width: 100%;\n      }\n      \n      .wptheme1Col .wpthemeCol {\n          width: 100%;\n      }\n\n      .wpthemeCol {\n          margin: 0px;\n      }\n\n      .wpthemeControl {\n        margin: 0px;\n      }\n\n      .wpthemeLayoutContainers {\n        padding: 0px\n      }\n    </style></head>\n\n<body cz-shortcut-listen=\"true\">\n\t<!-- Google Tag Manager (noscript) -->\n\t<noscript>\n\t\t<iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-WNLJX84Q\" height=\"0\" width=\"0\"\n\t\t\tstyle=\"display:none;visibility:hidden\"></iframe>\n\t</noscript>\n\t<!-- End Google Tag Manager (noscript) -->\n\t<div id=\"analytics\">\n\t\t<!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-G3W3M6971H\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'G-G3W3M6971H');\n</script>\n\n\n</div>\n\t<!-- site toolbar -->\n\t<!--VLibras-->\n\t<div vw class=\"enabled\">\n\t\t<div vw-access-button class=\"active\"></div>\n\n\t\t<div vw-plugin-wrapper>\n\t\t\t<div class=\"vw-plugin-top-wrapper\"></div>\n\t\t</div>\n\t</div>\n\t<div id=\"barra-gov\">\n\t\t<div class=\"gov-mobile\">\n\t\t\t<img src=\"/statics/periodo-eleitoral/assets/images/spgov-logo-branco.svg\" alt=\"Governo do Estado de São Paulo\" class=\"img-fluid\">\n\t\t</div>\n\t\t<div class=\"container\">\n\t\t\t<div class=\"row align-items-center justify-content-between px-4\">\n\t\t\t\t<div class=\"col-md col-lg-auto\">\n\t\t\t\t\t\n<span data-href=\"/sp\" id=\"stHomeLink\" class=\"stDisplayNone\" ></span>\n\n<style>\n#linkLogo:hover{\nbackground-image: none !important;\n}\n.navbar .nav-item.dropdown i {\n  color: #ff161f;\n  transition: 0.3s;\n}\n\n.navbar .nav-item.show > a{\n  border-bottom: 3px solid #ff161f;\n}\n</style>\n\n\n\n\n<a id=\"linkLogo\" class=\"logo\">\n            <span class=\"org only-text\">\n              Governo do Estado\n              <strong>de São Paulo</strong>\n            </span>\n </a>\n\n\n\n<script>\nlet linkHomeA = document.querySelector(\"#stHomeLink\");\nlet tagALogo = document.querySelector(\"#linkLogo\");\ntagALogo.setAttribute('href', linkHomeA.attributes[\"data-href\"].nodeValue);\n</script></div>\n\t\t\t\t<div class=\"col-auto\">\n\t\t\t\t\t<img class=\"govbr\" src=\"/statics/periodo-eleitoral/assets/images/logo-sp-governo-estado-light.svg\" alt=\"Governo do Estado de São Paulo\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t\n\n     <nav class=\"navbar navbar-expand-xl navbar-light\" aria-label=\"Portal Application\" role=\"navigation\" tabindex=\"-1\">\n    \t<div class=\"container\">\n\t\t      \n\t    <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarCollapse\" aria-controls=\"navbarCollapse\" \n\t    aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n      \n\t\t\t\t      <div class=\"collapse navbar-collapse\" id=\"navbarCollapse\">\n\t\t\t\t        <ul class=\"navbar-nav mr-auto\">\n\n                \n\t\t\t\t\t\t\t<li class=\"nav-item dropdown\">\t\t\t\t\n\t\t                     <a class=\"nav-link dropdown-toggle\" href=\"#\" id=\"Institucional\" data-toggle=\"dropdown\" aria-haspopup=\"true\"\n                               aria-expanded=\"false\">Institucional<i class=\"fas fa-chevron-down\"></i>\n                             </a>\n                        <ul class=\"dropdown-menu\" aria-labelledby=\"Institucional\">\n                        \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"/sp/institucional/estrutura\">\n\t\t\t\t\t\t\t        <span lang=\"en\" dir=\"ltr\">\n\t\t\t\t\t\t                      Estrutura\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"/sp/institucional/agenda_governador\">\n\t\t\t\t\t\t\t        <span lang=\"en\" dir=\"ltr\">\n\t\t\t\t\t\t                      Agenda do governador\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"/sp/institucional/mapa-site\">\n\t\t\t\t\t\t\t        <span lang=\"en\" dir=\"ltr\">\n\t\t\t\t\t\t                      Mapa do Site\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t\t             </ul>\n\t\t             \n\t\t\t\t\t\t\t<li class=\"nav-item dropdown\">\n\t\t\t\t\t\t\t\t<a href=\"https://servicos.sp.gov.br/\" class=\"nav-link\">\n\n                           \t\t\n\t\t                            <span lang=\"en\" dir=\"ltr\">Serviços</span>\n\t\t                        </a>\n\t\t\t\t\t\t\t\n\t\t                        \n\t\t\n\t\t                    </li>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<li class=\"nav-item dropdown\">\n\t\t\t\t\t\t\t\t<a href=\"/sp/conheca-sp\" class=\"nav-link\">\n\n                           \t\t\n\t\t                            <span lang=\"en\" dir=\"ltr\">Conheça SP</span>\n\t\t                        </a>\n\t\t\t\t\t\t\t\n\t\t                        \n\t\t\n\t\t                    </li>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t<li class=\"nav-item dropdown\">\t\t\t\t\n\t\t                     <a class=\"nav-link dropdown-toggle\" href=\"#\" id=\"Canais de Comunicação\" data-toggle=\"dropdown\" aria-haspopup=\"true\"\n                               aria-expanded=\"false\">Canais de Comunicação<i class=\"fas fa-chevron-down\"></i>\n                             </a>\n                        <ul class=\"dropdown-menu\" aria-labelledby=\"Canais de Comunicação\">\n                        \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"https://fala.sp.gov.br/\">\n\t\t\t\t\t\t\t        <span lang=\"en\" dir=\"ltr\">\n\t\t\t\t\t\t                      Fala SP\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"/sp/canais-comunicacao/assessoria_imprensa\">\n\t\t\t\t\t\t\t        <span lang=\"en\" dir=\"ltr\">\n\t\t\t\t\t\t                      Assessoria de Imprensa\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"https://www.controladoriageral.sp.gov.br/como-e-por-que-tratamos-dados-pessoais/\">\n\t\t\t\t\t\t\t        <span lang=\"en\" dir=\"ltr\">\n\t\t\t\t\t\t                      Privacidade e Proteção de Dados - LGPD\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t\t             </ul>\n\t\t             \n\t\t\t\t\t\t\t<li class=\"nav-item dropdown\">\t\t\t\t\n\t\t                     <a class=\"nav-link dropdown-toggle\" href=\"#\" id=\"Transparência \" data-toggle=\"dropdown\" aria-haspopup=\"true\"\n                               aria-expanded=\"false\">Transparência <i class=\"fas fa-chevron-down\"></i>\n                             </a>\n                        <ul class=\"dropdown-menu\" aria-labelledby=\"Transparência \">\n                        \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"https://www.transparencia.sp.gov.br/\">\n\t\t\t\t\t\t\t        <span lang=\"pt-BR\" dir=\"ltr\">\n\t\t\t\t\t\t                      Portal da Transparência\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t                           <li class=\"dropdown-item\">\t                           \n\t                           <a href=\"https://dadosabertos.sp.gov.br/\">\n\t\t\t\t\t\t\t        <span lang=\"pt-BR\" dir=\"ltr\">\n\t\t\t\t\t\t                      Portal de Dados Abertos\n\t\t\t\t\t\t            </span>\n\t                            </a>\n\t                           </li>\n\t                         \n\t\t             </ul>\n\t\t             \n               \n             </ul>\n            </div>\n           </div>\n        </nav>\n        <div class=\"wpthemeClear\"></div>\n\t<script>\n\n    let linkLi = document.createElement(\"li\");\n    linkLi.classList.add(\"nav-item\");\n    let tagA = document.createElement(\"a\");\n    tagA.classList.add(\"nav-link\");\n    tagA.classList.add(\"dropdown\");\n    let linkHome = document.querySelector(\"#stHomeLink\");\n    tagA.setAttribute('href', linkHome.attributes[\"data-href\"].nodeValue);\n    tagA.textContent = 'Início';\n    linkLi.appendChild(tagA);\n    let lista = document.querySelector(\"ul.navbar-nav.mr-auto\");\n\n    if (!(lista === null)) {\n        lista.prepend(linkLi);\n    }\n\n\n\n    function extrairPartesDominio(url) {\n      if (!url || typeof url !== 'string') return [];\n      let dominio = url.toLowerCase()\n        .replace(/^https?:\\/\\//, '')   \n        .replace(/^www\\./i, '');      \n      const indiceCorte = dominio.search(/[/?&#:]/);\n      if (indiceCorte !== -1) {\n        dominio = dominio.substring(0, indiceCorte);\n      }\n      dominio = dominio.replace(/\\.sp\\.gov\\.br$/i, '');\n      return dominio\n        .trim()\n        .split('.')\n        .filter(part => part.length > 0);\n    }\n\n function temPalavraEmComum(array1 = [], array2 = []) {\n  const PALAVRAS_CHAVE = new Set(['Poupatempo'].map(s => s.toLowerCase()));\n\n  return [...array1, ...array2].some(item => {\n    if (typeof item !== 'string') return false;\n    return PALAVRAS_CHAVE.has(item.trim().toLowerCase());\n  });\n}\n\nfunction initExternalLinkHandler() {\n  const links = document.querySelectorAll('ul.navbar-nav.mr-auto a[href]');\n  \n  links.forEach(link => {\n    link.addEventListener('click', function(e) {\n      const href = this.getAttribute('href');\n      \n      if (!href || href.startsWith('#') || href.startsWith('javascript:')) {\n        return;\n      }\n      \n      const currentDomain = window.location.hostname;\n      const tempLink = document.createElement('a');\n      tempLink.href = href;\n      const linkDomain = tempLink.hostname;\n       \n      const currentDomainParts = extrairPartesDominio(currentDomain); \n       const linkDomainParts = extrairPartesDominio(linkDomain);\n\n          if (temPalavraEmComum(currentDomainParts, linkDomainParts)) {\n            link.target = '_self';  \n            return;\n          }\n      \n      if (linkDomain && linkDomain !== currentDomain) {\n        e.preventDefault();\n        window.open(href, '_blank', 'noopener,noreferrer');\n      }\n    });\n  });\n}\n\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', initExternalLinkHandler);\n} else {\n  initExternalLinkHandler();\n}\n</script>\n\n<script>\n    const config = [\n    {\n      url: \"https://poupatempo.sp.gov.br/\",\n      label: \"poupatempo\"\n    },\n    {\n      url: \"https://www.procon.sp.gov.br/\",\n      label: \"procon\"\n    }\n  ];\n\n  function atualizarLinkLogo() {\n    const urlAtual = window.location.host;\n    const termo = config.find(item => urlAtual.toLowerCase().includes(item.label.toLowerCase()));\n   \n    const linkLogo = document.getElementById(\"linkLogo\");\n    if (linkLogo && termo) {\n      linkLogo.href = termo.url;\n    }\n  }\n\n  function redirecionar() {\n   \n    const urlAtual = window.location.href;\n    if (!urlAtual.toLowerCase().includes('admin')) {\n      const pathname = window.location.pathname;\n      if (pathname === '/poupatempo' || pathname === '/poupatempo/') {\n        window.location.replace('https://poupatempo.sp.gov.br/');\n      }\n    }\n  }\n\n  document.addEventListener('DOMContentLoaded', () => {\n    atualizarLinkLogo();\n    redirecionar();\n  });\n</script>\n\n<script>\n\n(function() {\n\n  const DOMINIOS_COM_SUBPASTAS = [\n    \"https://www.educacao.sp.gov.br\"\n\n  ];\n\n  function obterHostnameLimpo(urlStr) {\n    try {\n      const url = new URL(urlStr, window.location.origin);\n      return url.hostname.replace(/^www\\./i, '').toLowerCase();\n    } catch (e) {\n      return '';\n    }\n  }\n\n\n  function obterPrimeiroContextoPath(urlStr) {\n    try {\n      const url = new URL(urlStr, window.location.origin);\n\n      const partes = url.pathname.split('/').filter(p => p.length > 0);\n\n      return partes.length > 0 ? partes[0].toLowerCase() : '';\n    } catch (e) {\n      return '';\n    }\n  }\n\n\n  function deveAplicarRegraSubpasta(hostnameAtual) {\n    return DOMINIOS_COM_SUBPASTAS.some(dom => obterHostnameLimpo(dom) === hostnameAtual);\n  }\n\n  function initSubfolderLinkHandler() {\n    const currentHostname = window.location.hostname.replace(/^www\\./i, '').toLowerCase();\n\n    if (!deveAplicarRegraSubpasta(currentHostname)) {\n      return;\n    }\n\n    const links = document.querySelectorAll('ul.navbar-nav.mr-auto a[href]');\n    const contextoAtual = obterPrimeiroContextoPath(window.location.href);\n\n    links.forEach(link => {\n      link.addEventListener('click', function(e) {\n        const href = this.getAttribute('href');\n\n\n        if (!href || href.startsWith('#') || href.startsWith('javascript:')) {\n          return;\n        }\n\n        const linkHostname = obterHostnameLimpo(this.href); // 'this.href' resolve a URL completa automaticamente\n        const contextoLink = obterPrimeiroContextoPath(this.href);\n\n        if (linkHostname === currentHostname && contextoAtual !== contextoLink) {\n          e.preventDefault();\n          window.open(this.href, '_blank', 'noopener,noreferrer');\n        }\n      });\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initSubfolderLinkHandler);\n  } else {\n    initSubfolderLinkHandler();\n  }\n})();\n\n</script><!-- marca o nivel da pagina e renderiza banners na home e em periodo-eleitoral -->\n\t\n<script>\n\t(function () {\n\t\tvar r = document.documentElement;\n\t\tr.setAttribute('data-sp-level', '1');\n\t\tr.classList.add('sp-level-1');\n\t\tr.classList.add('sp-is-home');\n\t})();\n</script>\n\n\n\n\t<div id=\"sp-home-only\">\n\t\t<!-- coloque aqui o markup que deve aparecer somente na home -->\n\t\t<section class=\"componente\">\n\t\t\t<main role=\"main\">\n\t\t\t\t<div class=\"container banner-rotativo\">\n\t\t\t\t\t<div class=\"banner-simples-rotativo banner-tema-cms\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<a href=\"https://www.agenciasp.sp.gov.br/veja-dicas-para-economizar-agua-durante-periodo-de-estiagem/\">\n\t\t\t\t\t\t\t\t<img src=\"/statics/img/banner/tema/crise-hidrica-desktop.gif\" class=\"d-none d-md-block w-100 img-fluid\" alt=\"Banner Crise HÃ­drica\"/>\n\t\t\t\t\t\t\t\t<img src=\"/statics/img/banner/tema/crise-hidrica-mobile.gif\" class=\"d-block d-md-none w-100 img-fluid\" alt=\"Banner Crise HÃ­drica\"/>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<a href=\"https://www.spsemprealerta.sp.gov.br/\">\n\t\t\t\t\t\t\t\t<img src=\"/statics/img/banner/tema/sp-sempre-alerta-desktop.gif\" class=\"d-none d-md-block w-100 img-fluid\" alt=\"Banner SP Sempre Alerta\"/>\n\t\t\t\t\t\t\t\t<img src=\"/statics/img/banner/tema/sp-sempre-alerta-mobile.png\" class=\"d-block d-md-none w-100 img-fluid\" alt=\"Banner SP Sempre Alerta\"/>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<a href=\"https://www.vacina100duvidas.sp.gov.br/\">\n\t\t\t\t\t\t\t\t<img src=\"/statics/img/banner/tema/vacinacao-desktop.gif\" class=\"d-none d-md-block w-100 img-fluid\" alt=\"Banner VacinaÃ§Ã£o\"/>\n\t\t\t\t\t\t\t\t<img src=\"/statics/img/banner/tema/vacinacao-mobile.gif\" class=\"d-block d-md-none w-100 img-fluid\" alt=\"Banner VacinaÃ§Ã£o\"/>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</main>\n\t\t</section>\n\n\t\t<div class=\"container\" style=\"display: none;\">\n\t\t\t<section id=\"warning-alert-cms-exibir\">\n\t\t\t\t<div class=\"row\">\n\t\t\t\t\t<div class=\"col-md-12 mx-auto\">\n\t\t\t\t\t\t<div class=\"imagem-container warning-image\">\n\t\t\t\t\t\t\t<img src=\"/statics/img/warnings/noticias-periodo-eleitoral.jpeg\" alt=\"Aviso sobre restriÃ§Ãµes de publicaÃ§Ã£o de notÃ­cias durante o perÃ­odo eleitoral\">\n\t\t\t\t\t\t\t<a href=\"https://www.agenciasp.sp.gov.br\" target=\"_blank\" class=\"link-invisivel\"\n\t\t\t\t\t\t\t\taria-label=\"AgÃªncia SP\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</section>\n\t\t</div>\n\t</div>\n\n\t<div class=\"container\">\n\t\t<section id=\"warning-alert-cms\">\n\t\t\t<div class=\"row\">\n\t\t\t\t<div class=\"col-md-12 mx-auto\">\n\t\t\t\t\t<div class=\"alert alert-warning alert-dismissible fade show d-flex justify-content-between py-3\" role=\"alert\">\n\t\t\t\t\t\t<i class=\"fa-solid fa-triangle-exclamation p-3 fa-2x\"></i>\n\t\t\t\t\t\t<div class=\"col-md-11 p-2\">\n\t\t\t\t\t\t\tInformamos que será realizada uma janela de manutenção\n\t\t\t\t\t\t\tprogramada no ambiente do CMS, com início\n\t\t\t\t\t\t\t<strong>às 20h de sábado (22/08/2026)</strong> e término\n\t\t\t\t\t\t\tprevisto <strong>às 06h de segunda-feira (24/08/2026)</strong>.\n\t\t\t\t\t\t\t<br><br>Durante esse período, poderão ocorrer\n\t\t\t\t\t\t\t<strong>instabilidades, indisponibilidade temporária ou \n\t\t\t\t\t\t\toscilações no ambiente de AUTORIA</strong>\n\t\t\t\t\t\t\t(<strong>produção seguirá sem interrupções</strong>), em razão\n\t\t\t\t\t\t\tdas atividades de manutenção. As equipes técnicas estarão\n\t\t\t\t\t\t\tacompanhando o ambiente durante a janela, com o objetivo de\n\t\t\t\t\t\t\tgarantir a execução das atividades e a normalização dos serviços\n\t\t\t\t\t\t\tao término da manutenção.\n\t\t\t\t\t\t\t<br><br>Agradecemos a compreensão.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<button type=\"button\" class=\"close\" data-dismiss=\"alert\" aria-label=\"Close\">\n\t\t\t\t\t\t<span aria-hidden=\"true\">&times;</span>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\t</div>\n\n\t<div class=\"wpthemeMainContent\" role=\"main\" tabindex=\"-1\" aria-label=\"HCL Digital Experience\">\n\t\t<main role=\"main\">\n\t\t\t\n<div class=\"asa.page asa-hidden\" id=\"asa.page\">\n\t<span class=\"asa.page.id\">Z6_086423G03PSRC06M19CM9F3IC3</span>\n\n\t\n\n</div>\n\n<div class=\"wpthemeClear\"></div>\n\t\t\t\n<div class=\"wpthemeInner\">\n\t<div id=\"wpthemeStatusBarContainer\" class=\"wpthemeStatusBarContainer\">\n\n\t\t\n\t\t<noscript>\n\t\t\t<div class=\"wpthemeMessage\" role=\"alert\" wairole=\"alert\">\n\t\t\t\t<img class=\"wpthemeMsgIcon wpthemeMsgIconError\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" alt=\"Error\" />\n\t\t\t\t<span class=\"wpthemeAltText\">Error:</span>\n\t\t\t\t<div class=\"wpthemeMessageBody\">Javascript is disabled in this browser. This page requires Javascript. Modify your browser's settings to allow Javascript to execute. See your browser's documentation for specific instructions.</div>\n\t\t\t</div>\n\t\t</noscript>\n\n\t</div>\n</div>\n<!-- required - do not remove -->\n\t\t\t<div style=\"display:none\" id=\"portletState\">{}</div><div id=\"layoutContainers\" class=\"wpthemeLayoutContainers wpthemeLayoutContainersHidden\">\n\t\t\t\t<div class=\"wpthemeInner\">\n\t\t\t\t\t<div class=\"hiddenWidgetsDiv\">\n\t<!-- widgets in this container are hidden in the UI by default -->\n\t<div class='component-container ibmDndRow wpthemeRow hiddenWidgetsContainer wpthemeCol12of12 wpthemeFull id-Z7_086423G03PSRC06M19CM9F3IS4' name='ibmHiddenWidgets' ><div class='component-control id-Z7_086423G0393SC06M3NRIQG0KV6' ><span id=\"Z7_086423G0393SC06M3NRIQG0KV6\"></span><section class=\"ibmPortalControl wpthemeControl wpthemeHidden a11yRegionTarget\" role=\"region\">\n\n\t\n\t\n\t<div class=\"asa.portlet asa-hidden\" id=\"asa.portlet.Z7_086423G0393SC06M3NRIQG0KV6\">\n\t\t<span class=\"asa.portlet.id\">Z7_086423G0393SC06M3NRIQG0KV6</span>\n\n\t\t\n\n\t</div>\n\t\n<!-- start header markup -->\n\t<header class=\"wpthemeControlHeader\" role=\"banner\" aria-label=\"Skin header\">\n\t\t<div class=\"wpthemeInner\">\n\t\t\t<h2>\n\t\t\t\t<img class=\"dndHandle\" draggable=\"true\" ondragstart=\"wpModules.dnd.util.portletDragStart(event, this, this.parentNode, 30, 0);\"\n\t\t\t\tondragend=\"wpModules.dnd.util.portletDragEnd(event);\" \n\t\t\t\tsrc=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" alt=\"\"/>\n\t\t\t\t<!-- lm-dynamic-title node marks location for dynamic title support -->\n \t\t\t\t<span class=\"lm-dynamic-title asa.portlet.title a11yRegionLabel\"><span lang=\"en\" dir=\"ltr\">Web Content Viewer</span></span>\n\t\t\t</h2>\n\t\t\t<a aria-haspopup=\"true\" aria-label=\"Display content menu\" role=\"button\" href=\"javascript:;\" class=\"wpthemeIcon wpthemeMenuFocus contextMenuInSkinIcon\" style=\"display:none\" tabindex=\"0\">\n\t\t\t\t<span title=\"Display content menu\"><img aria-label=\"Display content menu\" alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\"></span>\n\t\t\t\t<span class=\"wpthemeAltText\">Component Action Menu</span>\n\t\t\t\t<!-- start CAM template -->\n\t\t\t\t<span class=\"wpthemeMenu\" data-positioning-handler=\"horizontallyCenteredBelow\">\n\t\t\t\t\t<div class=\"wpthemeMenuBorder\">\n\t\t\t\t\t\t<!-- define the menu item template inside the \"ul\" element.  only \"css-class\", \"description\", and \"title\" are handled by the theme's sample javascript. -->\n\t\t\t\t\t\t<ul class=\"wpthemeMenuDropDown wpthemeTemplateMenu\" role=\"menu\">\n\t\t\t\t\t\t\t<li class=\"${css-class}\" role=\"menuitem\" tabindex=\"-1\"><span\n\t\t\t\t\t\t\t\tclass=\"wpthemeMenuText\">${title}</span></li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<div class=\"verticalMenuPointer pointer\"></div>\n\t\t\t\t\t</div> <!-- Template for loading -->\n\t\t\t\t\t<div class=\"wpthemeMenuLoading wpthemeTemplateLoading\">${loading}</div>\n\t\t\t\t\t<!-- Template for submenu -->\n\t\t\t\t\t<div class=\"wpthemeAnchorSubmenu wpthemeTemplateSubmenu\">\n\t\t\t\t\t\t<div class=\"wpthemeMenuBorder wpthemeMenuSubmenu\">\n\t\t\t\t\t\t\t<ul id=\"${submenu-id}\" class=\"wpthemeMenuDropDown\"\n\t\t\t\t\t\t\t\trole=\"menu\">\n\t\t\t\t\t\t\t\t<li role=\"menuitem\" tabindex=\"-1\"></li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</span>\n\t\t\t\t<!-- end CAM template -->\n\t\t\t</a>\n\t\t\t<a aria-haspopup=\"true\" aria-label=\"Display portlet menu\" role=\"button\" href=\"javascript:;\" class=\"wpthemeIcon wpthemeMenuFocus\" tabindex=\"0\"\n                onclick=\"if (typeof wptheme != 'undefined') wptheme.contextMenu.init({ 'node': this, menuId: 'skinAction', jsonQuery: {'navID':ibmCfg.portalConfig.currentPageOID,'windowID':wptheme.getWindowIDFromSkin(this)}, params: {'alignment':'right'}});\"\n\t\t\t\tonkeydown=\"javascript:if (typeof i$ != 'undefined' &amp;&amp; typeof wptheme != 'undefined') {if (event.keyCode ==13 