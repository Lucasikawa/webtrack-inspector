ones {\n        color: #000000 !important;\n    }\n</style>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n        \n        \n            \n            <section id=\"categoria-servicos\" style=\"background-color:#ededed\" class=\"iamspe\">\n                \n                \n                <div class=\"container\">\n                    <!-- Card com Icone -->\n                    \n                    <!-- Titulo -->\n                    \n                    <h3 class=\"tit-area corDetalhesTitulo\">\n                        Serviços por Categoria</h3>\n                    \n                    \n                    <div class=\"row\">\n                       \n                            <div class=\"col-lg-12 mx-auto\">\n                                <div class='cardsServicos9c04ee28-563a-41fb-b9e3-ac0b20238bab\n                                  row justify-content-center mx-auto'>\n                                    \n\n                                    \n                                    <!-- Caminho dos conteudos para o Cards com Icone -->\n                                    \n                                    \n                                    \n                                    <!-- Menu dos cards com Icone -->\n                                    <!-- MN (Cards com icone) -->\n\n\n\n<!-- Cards -->\n<!-- link interno -->\n<div class=\"col-md-auto col-6 text-center\">\n    <div class=\"card card-body d-flex flex-column justify-content-center align-items-center\">\n        \n        \n        <!-- link externo -->\n        <a href='https://servicos.sp.gov.br/listagem/4/'\n            class=\"stretched-link corDetalhesHover\" target=\"_blank\">\n            <i class='fa-solid fa-graduation-cap corDosIcones'></i>\n            <span>Educação</span>\n        </a>\n        \n        \n        \n        \n        \n    </div>\n</div>\n\n<!-- MN (Cards com icone) -->\n\n\n\n<!-- Cards -->\n<!-- link interno -->\n<div class=\"col-md-auto col-6 text-center\">\n    <div class=\"card card-body d-flex flex-column justify-content-center align-items-center\">\n        \n        \n        <!-- link externo -->\n        <a href='https://servicos.sp.gov.br/listagem/167/'\n            class=\"stretched-link corDetalhesHover\" target=\"_blank\">\n            <i class='fa-solid fa-tree-city corDosIcones'></i>\n            <span>Serviços Municipais</span>\n        </a>\n        \n        \n        \n        \n        \n    </div>\n</div>\n\n<!-- MN (Cards com icone) -->\n\n\n\n<!-- Cards -->\n<!-- link interno -->\n<div class=\"col-md-auto col-6 text-center\">\n    <div class=\"card card-body d-flex flex-column justify-content-center align-items-center\">\n        \n        \n        <!-- link externo -->\n        <a href='https://servicos.sp.gov.br/listagem/2/'\n            class=\"stretched-link corDetalhesHover\" target=\"_blank\">\n            <i class='fa-solid fa-droplet corDosIcones'></i>\n            <span>Água, esgoto e meio ambiente</span>\n        </a>\n        \n        \n        \n        \n        \n    </div>\n</div>\n\n<!-- MN (Cards com icone) -->\n\n\n\n<!-- Cards -->\n<!-- link interno -->\n<div class=\"col-md-auto col-6 text-center\">\n    <div class=\"card card-body d-flex flex-column justify-content-center align-items-center\">\n        \n        \n        <!-- link externo -->\n        <a href='https://servicos.sp.gov.br/listagem/147/'\n            class=\"stretched-link corDetalhesHover\" target=\"_blank\">\n            <i class='fa-solid fa-user-shield corDosIcones'></i>\n            <span>Atendimento ao consumidor</span>\n        </a>\n        \n        \n        \n        \n        \n    </div>\n</div>\n\n<!-- MN (Cards com icone) -->\n\n\n\n<!-- Cards -->\n<!-- link interno -->\n<div class=\"col-md-auto col-6 text-center\">\n    <div class=\"card card-body d-flex flex-column justify-content-center align-items-center\">\n        \n        \n        