e=en&amp;locale=pt-BR&amp;locale=pt&amp;mime-type=text%2Fjavascript&amp;lm=1789971608000&amp;entry=wp_liveobject_framework_core__0.0%3Aconfig_js&amp;entry=wp_portal_ui_utils__0.0%3Aconfig_js&amp;entry=wp_contextmenu_js__0.0%3Aconfig_js&amp;entry=wp_toolbar_gridlayout_inlineedit__0.0%3Aconfig_js&amp;entry=wp_skin_cam__0.0%3Aconfig_js&amp;entry=wp_contextmenu_config_lof__0.0%3Aconfig_js&amp;entry=wp_federated_documents_picker__0.0%3Aconfig_js&amp;entry=wp_dnd_main__0.0%3Aconfig_js&amp;entry=wp_movecontrols__0.0%3Aconfig_js&amp;entry=wp_toolbar_controlactions__0.0%3Aconfig_js&amp;entry=wp_content_targeting_cam__0.0%3Aconfig_js&amp;entry=wp_analytics_tags__0.0%3Aconfig_js&amp;deferred=true\" style=\"display:none\"> Deferred Modules </a><span id=\"simpleMenuTemplate\" class=\"wpthemeMenuLeft\">\n    <div class=\"wpthemeMenuBorder\">\n        <div class=\"wpthemeMenuNotchBorder\"></div>\n        <!-- define the menu item template inside the \"ul\" element.  only \"css-class\", \"description\", and \"title\" are handled by the theme's sample javascript. -->\n        <ul class=\"wpthemeMenuDropDown wpthemeTemplateMenu\" role=\"menu\">\n            <li class=\"${css-class}\" role=\"menuitem\" tabindex=\"-1\" aria-label=\"${title}\"><span class=\"wpthemeMenuText\">${title}</span>${badge}</li>\n        </ul>\n    </div>\n    <!-- Template for loading -->\n    <div class=\"wpthemeMenuLoading wpthemeMenuLoadingText wpthemeTemplateLoading\">${loading}</div>\n    <!-- Template for submenu -->\n    <div class=\"wpthemeAnchorSubmenu wpthemeTemplateSubmenu\">\n        <div class=\"wpthemeMenuBorder wpthemeMenuSubmenu\">\n            <ul id=\"${submenu-id}\" class=\"wpthemeMenuDropDown\" role=\"menu\"><li role=\"menuitem\" tabindex=\"-1\"></li></ul>\n        </div>\n    </div>\n</span><a rel=\"alternate\" id=\"config_markup_deferred\" href=\"/contenthandler/!ut/p/digest!HfYciOLTevo7ANhAmsCrHQ/mashup/ra:collection?themeID=ZJ_086423G0313SC06QD0S50410V0&amp;locale=en&amp;locale=pt-BR&amp;locale=pt&amp;mime-type=text%2Fplain&amp;entry=wp_contextmenu_templates__0.0%3Aconfig_markup&amp;entry=wp_toolbar_gridlayout_inlineedit__0.0%3Aconfig_markup&amp;entry=wp_skin_cam__0.0%3Aconfig_markup&amp;entry=wp_dnd_main__0.0%3Aconfig_markup&amp;deferred=true\" style=\"display:none\"> Deferred Modules </a></div>\n\t<!-- Modal Aviso Timeout -->\n\t<div id=\"modal-screen-alt\">\n\t\t<div id=\"overlay\" class=\"overlay\"></div>\n\t\t<div class=\"body-login\">\n\t\t\t<div class=\"container custom-modal modal-login\">\n\t\t\t\t<div id=\"meuModal\" class=\"modalConexao\">\n\t\t\t\t\t<div class=\"modal-conteudo\">\n\t\t\t\t\t\t<h2>Sua sessão está prestes a expirar. Deseja continuar conectado?</h2>\n\t\t\t\t\t\t<button id=\"continuarSessao\"\n\t\t\t\t\t\t\tclass=\"btn btn-outline-custom rounded-pill btn-manterConexao col-lg-5 m-2\"\n\t\t\t\t\t\t\tonclick=\"renewSession()\">Manter Conexão</button>\n\t\t\t\t\t\t<button id=\"sairSessao\" class=\"btn btn-outline-custom rounded-pill col-lg-5 m-2\"\n\t\t\t\t\t\t\tonclick=\"logout()\">Sair</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<!-- Modal LGPD -->\n\t<div id=\"lgpdModal\" aria-labelledby=\"modalLgpd\" class=\"lgpd-modal\" role=\"dialog\" aria-modal=\"true\">\n\t\t<p>\n\t\t\tEste site utiliza apenas cookies essenciais para garantir seu funcionamento e melhorar sua experiência\n\t\t\tde navegação. Ao continuar, você declara aceitar e estar de acordo com nossos\n\t\t\t<a href=\"https://www.cms.sp.gov.br/cms/termo-uso\" target=\"_blank\">Termo de Uso</a> e\n\t\t\t<a href=\"https://www.cms.sp.gov.br/cms/politica-privacidade\" target=\"_blank\">Política de Privacidade</a>.\n\t\t</p>\n\t\t<button type=\"submit\" id=\"cadastrar\" class=\"lgpd-btn\">Aceitar</button>\n\t</div>\n\t<script>\n\t\tconst modalWarningCms = document.getElementById(\"modalCustomWarning\");\n\t\tconst btnCloseWarningCms = document.querySelector(\".btn-close-modal-warning-cms\");\n\n\t\tfunction abrirModalWarningCms() {\n\t\t\tif (modalWarningCms) {\n\t\t\t\tmodalWarningCms.style.display = \"block\";\n\t\t\t}\n\t\t}\n\n\t\tif (btnCloseWarningCms) {\n\t\t\tbtnCloseWarningCms.onclick = function () {\n\t\t\t\tif (modalWarningCms) {\n\t\t\t\t\tmodalWarningCms.style.display = \"none\";\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\twindow.onclick = function (event) {\n\t\t\tif (modalWarningCms && event.target === modalWarningCms) {\n\t\t\t\tmodalWarningCms.style.display = \"none\";\n\t\t\t}\n\t\t}\n\t</script>\n<script type=\"text/javascript\" src=\"/_Incapsula_Resource?SWJIYLWA=719d34d31c8e3a6e6fffd425f7e032f3&ns=51&cb=1435485862\" async></script></body>\n\n</html>\r"
